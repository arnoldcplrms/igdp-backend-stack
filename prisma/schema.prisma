generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        Int       @id @default(autoincrement())
  name      String
  address   String
  createdAt DateTime  @default(dbgenerated("CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Manila'")) @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @db.Timestamptz(6)
}

model Company {
  id        Int       @id @default(autoincrement())
  name      String
  address   String
  createdAt DateTime  @default(dbgenerated("CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Manila'")) @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @db.Timestamptz(6)
}
