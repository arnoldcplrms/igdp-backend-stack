generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Church {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  address   String
  createdAt DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  // Relations
  accounts   Account[]
  ministries Ministry[]
  events     Event[]
  dGroups    DGroup[]
  series     Series[]
}

model School {
  id        Int      @id @default(autoincrement())
  name      String
  acronym   String?  @db.VarChar(20)
  address   String
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  enrolledStudentCount Int @default(0)
  alumniStudentCount   Int @default(0)

  education Education[]

  @@unique([name, address])
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  acronym   String?  @db.VarChar(20)
  address   String
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  employedCount       Int @default(0)
  formerEmployeeCount Int @default(0)

  Employment Employment[]

  @@unique([name, address])
}

model Ministry {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  parentMinistry Int?
  churchId       Int
  mission        String?  @db.Text
  vision         String?  @db.Text
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  parent          Ministry?         @relation("MinistryHierarchy", fields: [parentMinistry], references: [id])
  children        Ministry[]        @relation("MinistryHierarchy")
  church          Church            @relation(fields: [churchId], references: [id])
  roles           MinistryRole[]
  accounts        AccountMinistry[]
  series          Series[]
  events          Event[]
  eventMinistries EventMinistry[]

  @@unique([name, parentMinistry, churchId])
}

model MinistryRole {
  id         Int    @id @default(autoincrement())
  ministryId Int
  roleName   String @db.VarChar(100)

  ministry        Ministry          @relation(fields: [ministryId], references: [id])
  accountMinistry AccountMinistry[]

  @@unique([ministryId, roleName])
}

enum DGroupStatus {
  D12
  Dleader
  Facilitator
  DMember
  Pending
}

enum DGroupType {
  Singles
  Couples
}

enum LifeStage {
  Couples
  B1G
  Elevate
}

enum DGroupMembershipRole {
  Member
  Leader
}

model DGroup {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(100)
  churchId    Int
  type        DGroupType
  memberships DGroupMembership[]
  createdAt   DateTime           @default(now()) @db.Timestamp(6)
  updatedAt   DateTime           @updatedAt @db.Timestamp(6)
  // Relations
  church      Church             @relation(fields: [churchId], references: [id])
}

model DGroupMembership {
  id Int @id @default(autoincrement())

  dgroupId Int
  dgroup   DGroup @relation(fields: [dgroupId], references: [id])

  role DGroupMembershipRole @default(Member)

  createdAt DateTime @default(now())

  // 👇 polymorphic-style relation (IMPORTANT PART)
  accountId Int?
  account   Account? @relation(fields: [accountId], references: [id])

  coupleId Int?
  couple   Couple? @relation(fields: [coupleId], references: [id])
}

enum Gender {
  Male
  Female
}

enum UserType {
  Admin
  MinistryHead
  DGM
  Member
}

enum EducationLevel {
  JuniorHigh
  SeniorHigh
  College
  Masteral
  Doctoral
}

model Account {
  id                     Int      @id @default(autoincrement())
  firstName              String   @db.VarChar(50)
  middleName             String?  @db.VarChar(50)
  lastName               String   @db.VarChar(50)
  nickname               String?  @db.VarChar(50)
  profilePicture         String?  @db.VarChar(255)
  facebookLink           String?  @db.VarChar(255)
  contactNumber          String?  @db.VarChar(20)
  email                  String   @unique @db.VarChar(100)
  gender                 Gender
  birthDate              DateTime @db.Date
  userType               UserType @default(Member)
  churchId               Int
  emergencyContactName   String?  @db.VarChar(100)
  emergencyContactNumber String?  @db.VarChar(20)
  createdAt              DateTime @default(now()) @db.Timestamp(6)
  updatedAt              DateTime @updatedAt @db.Timestamp(6)

  church            Church             @relation(fields: [churchId], references: [id])
  education         Education[]
  employment        Employment[]
  ministries        AccountMinistry[]
  attendances       Attendance[]       @relation("AttendeeAccount")
  speakerAccount    Speaker[]          @relation("SpeakerAccount")
  speakerUpdatedBy  Speaker[]          @relation("SpeakerUpdatedBy")
  dGroupMemberships DGroupMembership[]
  couple            Couple?            @relation(fields: [coupleId], references: [id])
  coupleId          Int?
  husbandCouple     Couple?            @relation("HusbandRelation")
  wifeCouple        Couple?            @relation("WifeRelation")
}

model Couple {
  id Int @id @default(autoincrement())

  husbandId Int @unique
  wifeId    Int @unique

  createdAt         DateTime           @default(now()) @db.Timestamp(6)
  updatedAt         DateTime           @updatedAt @db.Timestamp(6)
  accounts          Account[]
  dgroupMemberships DGroupMembership[]

  husband Account @relation("HusbandRelation", fields: [husbandId], references: [id])
  wife    Account @relation("WifeRelation", fields: [wifeId], references: [id])
}

model AccountMinistry {
  id             Int      @id @default(autoincrement())
  accountId      Int
  ministryId     Int
  ministryRoleId Int
  isPrimary      Boolean  @default(false)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  account      Account      @relation(fields: [accountId], references: [id])
  ministry     Ministry     @relation(fields: [ministryId], references: [id])
  ministryRole MinistryRole @relation(fields: [ministryRoleId], references: [id])

  @@unique([accountId, ministryId])
}

model Education {
  id             Int            @id @default(autoincrement())
  schoolId       Int
  accountId      Int
  educationLevel EducationLevel
  course         String?        @db.VarChar(150)
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  createdAt      DateTime       @default(now()) @db.Timestamp(6)
  updatedAt      DateTime       @updatedAt @db.Timestamp(6)

  school  School  @relation(fields: [schoolId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}

model Employment {
  id        Int       @id @default(autoincrement())
  companyId Int
  accountId Int
  position  String    @db.VarChar(100)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)

  // Relations
  company Company @relation(fields: [companyId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}

model Speaker {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  accountId Int?
  updatedBy Int?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  account       Account?        @relation("SpeakerAccount", fields: [accountId], references: [id])
  updatedByUser Account?        @relation("SpeakerUpdatedBy", fields: [updatedBy], references: [id])
  eventSpeakers EventSpeakers[]
}

model Series {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  ministryId Int?
  churchId   Int?
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)

  // Relations
  ministry Ministry? @relation(fields: [ministryId], references: [id])
  church   Church?   @relation(fields: [churchId], references: [id])
  events   Event[]
}

model Event {
  id         Int      @id @default(autoincrement())
  eventName  String   @db.VarChar(100)
  eventDate  DateTime @db.Date
  location   String   @db.VarChar(100)
  seriesId   Int?
  ministryId Int?
  churchId   Int?
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)

  // Relations
  series          Series?         @relation(fields: [seriesId], references: [id])
  ministry        Ministry?       @relation(fields: [ministryId], references: [id])
  church          Church?         @relation(fields: [churchId], references: [id])
  attendances     Attendance[]
  eventSpeakers   EventSpeakers[]
  eventMinistries EventMinistry[]
}

model EventMinistry {
  eventId            Int
  ministryId         Int
  isPrimaryOrganizer Boolean?

  event    Event    @relation(fields: [eventId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@id([eventId, ministryId])
}

model Attendance {
  eventId   Int
  accountId Int
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  event   Event   @relation(fields: [eventId], references: [id])
  account Account @relation("AttendeeAccount", fields: [accountId], references: [id])

  @@id([eventId, accountId])
  @@unique([eventId, accountId], name: "unique_event_account_attendance")
}

model EventSpeakers {
  speakerId Int
  eventId   Int
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  speaker Speaker @relation(fields: [speakerId], references: [id])
  event   Event   @relation(fields: [eventId], references: [id])

  @@id([speakerId, eventId])
}
