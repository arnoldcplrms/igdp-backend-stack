generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        Int       @id @default(autoincrement())
  name      String
  address   String
  createdAt DateTime  @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @db.Timestamptz(6)

  // Relations
  account   Account @relation(fields: [accountId], references: [id])
  accountId Int     @default(0)

  @@index([accountId], name: "idx_school_account_id")
}

model Company {
  id        Int       @id @default(autoincrement())
  name      String
  address   String
  createdAt DateTime  @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @db.Timestamptz(6)
}

enum Gender {
  Male
  Female
}

enum UserType {
  Admin
  MinistryHead
  DGM
  Member
}

model Account {
  id                     Int      @id @default(autoincrement())
  firstName              String   @db.VarChar(50)
  middleName             String?  @db.VarChar(50)
  lastName               String   @db.VarChar(50)
  facebookLink           String?  @db.VarChar(255)
  contactNumber          String   @db.VarChar(20)
  email                  String   @db.VarChar(100)
  gender                 Gender
  birthDate              DateTime @db.Date
  userType               UserType
  dGroupLeaderId         Int?
  createdAt              DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt              DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @updatedAt @db.Timestamptz(6)
  emergencyContactName   String?  @db.VarChar(100)
  emergencyContactNumber String?  @db.VarChar(20)

  dGroupLeader  Account?  @relation("dGroupLeader", fields: [dGroupLeaderId], references: [id])
  dGroupMembers Account[] @relation("dGroupLeader")
  school        School[]
}
