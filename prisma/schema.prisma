generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        Int         @id @default(autoincrement())
  name      String
  address   String
  createdAt DateTime    @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt DateTime?   @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  education Education[]
}

model Company {
  id         Int          @id @default(autoincrement())
  name       String
  address    String
  createdAt  DateTime     @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt  DateTime?    @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  Employment Employment[]
}

enum Gender {
  Male
  Female
}

enum UserType {
  Admin
  MinistryHead
  DGM
  Member
}

enum GradeYear {
  PreSchool
  Kindergarten
  Grade1
  Grade2
  Grade3
  Grade4
  Grade5
  Grade6
  Grade7
  Grade8
  Grade9
  Grade10
  Grade11
  Grade12
  FirstYearCollege
  SecondYearCollege
  ThirdYearCollege
  FourthYearCollege
  FifthYearCollege
  UnderGraduate
  Graduated
}

model Account {
  id                     Int      @id @default(autoincrement())
  firstName              String   @db.VarChar(50)
  middleName             String?  @db.VarChar(50)
  lastName               String   @db.VarChar(50)
  nickname               String?  @db.VarChar(50)
  profilePicture         String?  @db.VarChar(255)
  facebookLink           String?  @db.VarChar(255)
  contactNumber          String   @db.VarChar(20)
  email                  String   @db.VarChar(100)
  gender                 Gender
  birthDate              DateTime @db.Date
  userType               UserType
  dGroupLeaderId         Int?
  createdAt              DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt              DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  emergencyContactName   String?  @db.VarChar(100)
  emergencyContactNumber String?  @db.VarChar(20)

  dGroupLeader  Account?     @relation("dGroupLeader", fields: [dGroupLeaderId], references: [id])
  dGroupMembers Account[]    @relation("dGroupLeader")
  education     Education[]
  employment    Employment[]
  events        Event[]
}

model Education {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  accountId Int
  gradeYear GradeYear
  course    String?   @db.VarChar(150)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt DateTime  @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)

  // Relations
  school  School  @relation(fields: [schoolId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}

model Employment {
  id        Int       @id @default(autoincrement())
  companyId Int
  accountId Int
  position  String?   @db.VarChar(100)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt DateTime  @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)

  // Relations
  company Company @relation(fields: [companyId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}

model Series {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  createdAt DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)

  // Relations
  events Event[]
}

model Event {
  id        Int      @id @default(autoincrement())
  eventName String   @db.VarChar(100)
  eventDate DateTime @db.Date
  location  String   @db.VarChar(100)
  speakerId Int
  seriesId  Int?
  createdAt DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Manila')")) @db.Timestamptz(6)

  // Relations
  speaker Account @relation(fields: [speakerId], references: [id])
  series  Series? @relation(fields: [seriesId], references: [id])
}
