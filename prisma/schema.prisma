generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        Int         @id @default(autoincrement())
  name      String
  acronym   String?     @db.VarChar(20)
  address   String
  createdAt DateTime    @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt DateTime?   @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  education Education[]
}

model Company {
  id         Int          @id @default(autoincrement())
  name       String
  acronym    String?      @db.VarChar(20)
  address    String
  createdAt  DateTime     @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt  DateTime?    @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  Employment Employment[]
}

model Ministry {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  parentMinistry Int?
  mission        String?  @db.Text
  vision         String?  @db.Text
  description    String?  @db.Text
  createdAt      DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt      DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  // Relations
  parent   Ministry?         @relation("MinistryHierarchy", fields: [parentMinistry], references: [id])
  children Ministry[]        @relation("MinistryHierarchy")
  roles    MinistryRole[]
  accounts AccountMinistry[]
  series   Series[]
  events   Event[]
}

model MinistryRole {
  id         Int    @id @default(autoincrement())
  ministryId Int
  roleName   String @db.VarChar(100)

  ministry        Ministry          @relation(fields: [ministryId], references: [id])
  accountMinistry AccountMinistry[]

  @@unique([id, ministryId])
}

enum Gender {
  Male
  Female
}

enum UserType {
  Admin
  MinistryHead
  DGM
  Member
}

enum GradeYear {
  PreSchool
  Kindergarten
  Grade1
  Grade2
  Grade3
  Grade4
  Grade5
  Grade6
  Grade7
  Grade8
  Grade9
  Grade10
  Grade11
  Grade12
  FirstYearCollege
  SecondYearCollege
  ThirdYearCollege
  FourthYearCollege
  FifthYearCollege
  UnderGraduate
  Graduated
}

model Account {
  id                     Int      @id @default(autoincrement())
  firstName              String   @db.VarChar(50)
  middleName             String?  @db.VarChar(50)
  lastName               String   @db.VarChar(50)
  nickname               String?  @db.VarChar(50)
  profilePicture         String?  @db.VarChar(255)
  facebookLink           String?  @db.VarChar(255)
  contactNumber          String   @db.VarChar(20)
  email                  String   @db.VarChar(100)
  gender                 Gender
  birthDate              DateTime @db.Date
  userType               UserType
  dGroupLeaderId         Int?
  createdAt              DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt              DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  emergencyContactName   String?  @db.VarChar(100)
  emergencyContactNumber String?  @db.VarChar(20)

  dGroupLeader       Account?          @relation("dGroupLeader", fields: [dGroupLeaderId], references: [id])
  dGroupMembers      Account[]         @relation("dGroupLeader")
  education          Education[]
  employment         Employment[]
  ministries         AccountMinistry[]
  attendances        Attendance[]      @relation("AttendeeAccount")
  deletedAttendances Attendance[]      @relation("DeletedByAccount")
  speakerAccount     Speaker[]         @relation("SpeakerAccount")
  speakerUpdatedBy   Speaker[]         @relation("SpeakerUpdatedBy")
}

model AccountMinistry {
  id             Int      @id @default(autoincrement())
  accountId      Int
  ministryId     Int
  ministryRoleId Int
  isPrimary      Boolean  @default(false)
  description    String?  @db.Text
  createdAt      DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt      DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  account      Account      @relation(fields: [accountId], references: [id])
  ministry     Ministry     @relation(fields: [ministryId], references: [id])
  ministryRole MinistryRole @relation(fields: [ministryRoleId, ministryId], references: [id, ministryId])

  @@unique([accountId, ministryId])
}

model Education {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  accountId Int
  gradeYear GradeYear
  course    String?   @db.VarChar(150)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt DateTime  @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  // Relations
  school  School  @relation(fields: [schoolId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}

model Employment {
  id        Int       @id @default(autoincrement())
  companyId Int
  accountId Int
  position  String?   @db.VarChar(100)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt DateTime  @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  // Relations
  company Company @relation(fields: [companyId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}

model Speaker {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  accountId Int?
  updatedBy Int?
  createdAt DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  // Relations
  account       Account?        @relation("SpeakerAccount", fields: [accountId], references: [id])
  updatedByUser Account?        @relation("SpeakerUpdatedBy", fields: [updatedBy], references: [id])
  eventSpeakers EventSpeakers[]
}

model Series {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  ministryId Int?
  createdAt  DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt  DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  // Relations
  ministry Ministry? @relation(fields: [ministryId], references: [id])
  events   Event[]
}

model Event {
  id         Int      @id @default(autoincrement())
  eventName  String   @db.VarChar(100)
  eventDate  DateTime @db.Date
  location   String   @db.VarChar(100)
  seriesId   Int?
  ministryId Int?
  createdAt  DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt  DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  // Relations
  series        Series?         @relation(fields: [seriesId], references: [id])
  ministry      Ministry?       @relation(fields: [ministryId], references: [id])
  attendances   Attendance[]
  eventSpeakers EventSpeakers[]
}

model Attendance {
  eventId   Int
  accountId Int
  isDeleted Boolean   @default(false)
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy Int?
  createdAt DateTime  @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)
  updatedAt DateTime  @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  // Relations
  event         Event    @relation(fields: [eventId], references: [id])
  account       Account  @relation("AttendeeAccount", fields: [accountId], references: [id])
  deletedByUser Account? @relation("DeletedByAccount", fields: [deletedBy], references: [id])

  @@id([eventId, accountId])
  @@unique([eventId, accountId], name: "unique_event_account_attendance")
}

model EventSpeakers {
  speakerId Int
  eventId   Int
  createdAt DateTime @default(dbgenerated("timezone('Asia/Manila'::text, now())")) @db.Timestamp(6)

  // Relations
  speaker Speaker @relation(fields: [speakerId], references: [id])
  event   Event   @relation(fields: [eventId], references: [id])

  @@id([speakerId, eventId])
}
